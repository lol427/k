\begin{lema}
Fie $A,B\in M_n(\mathbb C)$ și fie
\[
\varepsilon
=\cos\frac{2\pi}{n}+i\sin\frac{2\pi}{n}.
\]
Atunci are loc identitatea
\[
\det(A+B)+\det(A+\varepsilon B)+\cdots+\det(A+\varepsilon^{\,n-1}B)
= n\bigl(\det A+\det B\bigr).
\]
\end{lema}

\begin{proof}
Considerăm polinomul
\[
P(X)=\det(A+XB)\in\mathbb C[X].
\]
Acesta are grad cel mult $n$ și admite dezvoltarea
\[
P(X)=\sum_{k=0}^n c_k X^k,
\qquad
c_0=\det A,
\quad
c_n=\det B.
\]

Evaluăm polinomul în valorile $\varepsilon^j$, $j=0,1,\dots,n-1$, și sumăm:
\[
\sum_{j=0}^{n-1} P(\varepsilon^j)
=\sum_{k=0}^n c_k \sum_{j=0}^{n-1} (\varepsilon^j)^k.
\]

Pentru orice $k\in\{0,1,\dots,n\}$ avem
\[
\sum_{j=0}^{n-1} (\varepsilon^j)^k
=\begin{cases}
n, & k=0 \text{ sau } k=n,\\
0, & \text{altfel}.
\end{cases}
\]
(Aplicam formula progresiei geometrice)\newline

Prin urmare,
\[
\sum_{j=0}^{n-1} P(\varepsilon^j)
= n(c_0+c_n)
= n\bigl(\det A+\det B\bigr),
\]
adică
\[
\det(A+B)+\det(A+\varepsilon B)+\cdots+\det(A+\varepsilon^{\,n-1}B)
= n\bigl(\det A+\det B\bigr).
\]
\end{proof}

\begin{observatie}[cazul $n=2$]
Pentru $n=2$ avem $\varepsilon=-1$, iar lema devine
\[
\det(A+B)+\det(A-B)=2(\det A+\det B),
\qquad \forall A,B\in M_2(\mathbb C).
\]
\end{observatie}

