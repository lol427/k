\chapter{Determinanți speciali}\label{ch:detspeciali}
\subsection{Determinantul unei matrici triunghiulare}

Fie $A=(a_{ij}) \in M_n(\mathbb{K})$ o matrice triunghiulară,adica o matrice de forma % Matrice triunghiulară superioară
\[
A_{\text{superioară}} =
\begin{pmatrix}
* & * & * & \cdots & * \\
0 & * & * & \cdots & * \\
0 & 0 & * & \cdots & * \\
\vdots & \vdots & \vdots & \ddots & \vdots \\
0 & 0 & 0 & \cdots & *
\end{pmatrix}
\]
sau de forma
% Matrice triunghiulară inferioară
\[
A_{\text{inferioară}} =
\begin{pmatrix}
* & 0 & 0 & \cdots & 0 \\
* & * & 0 & \cdots & 0 \\
* & * & * & \cdots & 0 \\
\vdots & \vdots & \vdots & \ddots & 0 \\
* & * & * & \cdots & *
\end{pmatrix}
\].
Atunci:
\[
\det A = \prod_{i=1}^n a_{ii}.
\]

\textbf{Demonstrație.}
Prin dezvoltarea determinantului după definiție,
\[
\det A = \sum_{\sigma \in S_n} \operatorname{sgn}(\sigma)
\prod_{i=1}^n a_{i,\sigma(i)}.
\]
Dacă $\sigma \neq \mathrm{id}$, există un indice $i$ cu $\sigma(i) \neq i$, iar
termenul corespunzător conține un element situat sub (sau deasupra) diagonalei,
care este zero deoarece matricea este triunghiulară.
Prin urmare, singurul termen nenul este cel corespunzător permutării identice,
de unde rezultă
\[
\det A = \prod_{i=1}^n a_{ii}.
\]
\hfill$\square$

\subsection{Determinantul Vandermonde}

Fie $x_1,x_2,\dots,x_n \in \mathbb{K}$.
Determinantul Vandermonde este
\[
V(x_1,\dots,x_n)
=
\begin{vmatrix}
1 & 1 & \cdots & 1 \\
x_1 & x_2 & \cdots & x_n \\
x_1^2 & x_2^2 & \cdots & x_n^2 \\
\vdots & \vdots & \ddots & \vdots \\
x_1^{n-1} & x_2^{n-1} & \cdots & x_n^{n-1}
\end{vmatrix}
=
\prod_{1 \le i < j \le n} (x_j - x_i).
\]

\textbf{Demonstrație.}
Considerăm determinantul ca funcție de variabilele $x_1,\dots,x_n$.
Dacă $x_i = x_j$ pentru $i \neq j$,
două coloane devin egale, deci determinantul este zero.
Prin urmare, fiecare factor $(x_j - x_i)$ divide determinantul(Teorema 3 de la radacini si factorizarea polinoamelor).

Gradul total al determinantului este $\frac{n(n-1)}{2}$,
egal cu gradul produsului
\[
\prod_{i<j} (x_j - x_i),
\]
deci determinantul este acest produs înmulțit cu o constantă.
Comparând coeficientul termenului de grad maxim, constanta este $1$,
iar formula rezultă.
\hfill$\square$

\subsection{Determinantul Vandermonde lacunar (o singură linie lipsă)}

Fie $n \ge 2$ și $k \in \{0,1,\dots,n\}$.
Prin \emph{determinant Vandermonde lacunar cu o singură linie lipsă}
înțelegem determinantul obținut din determinantul Vandermonde clasic
prin eliminarea liniei corespunzătoare exponentului $k$.
Îl notăm cu
\[
V_k(a_1,a_2,\dots,a_n)
=
\begin{vmatrix}
a_1^{0} & a_2^{0} & \cdots & a_n^{0} \\
a_1^{1} & a_2^{1} & \cdots & a_n^{1} \\
\vdots & \vdots & \ddots & \vdots \\
a_1^{k-1} & a_2^{k-1} & \cdots & a_n^{k-1} \\
a_1^{k+1} & a_2^{k+1} & \cdots & a_n^{k+1} \\
\vdots & \vdots & \ddots & \vdots \\
a_1^{n} & a_2^{n} & \cdots & a_n^{n}
\end{vmatrix}.
\]

Are loc factorizarea
\[
\boxed{
V_k(a_1,a_2,\dots,a_n)
=
V(a_1,a_2,\dots,a_n)\, e_{n-k}(a_1,a_2,\dots,a_n),
}
\]
unde $e_{n-k}$ este polinomul simetric fundamental de grad $n-k$:
\[
e_{n-k}(a_1,\dots,a_n)
=
\sum_{1 \le i_1 < i_2 < \cdots < i_{n-k} \le n} a_{i_1} a_{i_2} \cdots a_{i_{n-k}},
\qquad e_0 = 1.
\]
Pentru $k = n$ regăsim determinantul Vandermonde obișnuit.

\textbf{Demonstrație.}
Considerăm determinantul Vandermonde de ordin $n+1$ în care ultima variabilă este $x$:
\[
D(x) = V(a_1,\dots,a_n,x)
=
\begin{vmatrix}
1 & \cdots & 1 & 1\\
a_1 & \cdots & a_n & x\\
\vdots & & \vdots & \vdots\\
a_1^{n} & \cdots & a_n^{n} & x^{n}
\end{vmatrix}
= V(a_1,\dots,a_n)\prod_{i=1}^{n}(x - a_i).
\]
Membrul drept este un polinom în $x$ cu rădăcinile $a_1,\dots,a_n$ și, conform relațiilor lui Viète,
\[
\prod_{i=1}^{n}(x - a_i) = \sum_{j=0}^{n} (-1)^{n-j} e_{n-j}(a_1,\dots,a_n)\, x^{j}.
\]
Pe de altă parte, dezvoltând $D(x)$ după ultima coloană, coeficientul lui $x^k$ (aflat pe linia $k+1$ și coloana $n+1$) este $(-1)^{(k+1)+(n+1)} V_k(a_1,\dots,a_n) = (-1)^{n+k} V_k(a_1,\dots,a_n)$.
Identificând coeficienții lui $x^k$ obținem
\[
(-1)^{n+k} V_k(a_1,\dots,a_n) = (-1)^{n-k} V(a_1,\dots,a_n)\, e_{n-k}(a_1,\dots,a_n),
\]
iar cum $(-1)^{n+k} = (-1)^{n-k}$, formula rezultă.
\hfill$\square$


\subsection*{Exemplu}

Pentru $n=3$ și $k=1$, obținem
\[
V_1(x_1,x_2,x_3)
=
\begin{vmatrix}
1 & 1 & 1 \\
x_1^{2} & x_2^{2} & x_3^{2} \\
x_1^{3} & x_2^{3} & x_3^{3}
\end{vmatrix}
=
(x_2-x_1)(x_3-x_1)(x_3-x_2)
\cdot
(x_1x_2+x_1x_3+x_2x_3).
\]
De exemplu, pentru $(x_1,x_2,x_3) = (0,1,2)$ determinantul este $\begin{vmatrix} 1 & 1 & 1\\ 0 & 1 & 4\\ 0 & 1 & 8\end{vmatrix} = 4$, iar membrul drept este $1 \cdot 2 \cdot 1 \cdot (0 + 0 + 2) = 4$.

Vom folosi determinanții Vandermonde pentru a demonstra următorul rezultat foarte important.

\begin{lema}[Jacobson]
Fie $A,B \in M_n(\mathbb{C})$ astfel încât matricele $A$ și $[A,B]$ comută.
Atunci matricea $[A,B]$ este nilpotentă.
\end{lema}

Demonstrația folosește următorul rezultat ajutător.

\begin{lema}
Fie $Z \in M_n(\mathbb{C})$ o matrice. Dacă
\[
\operatorname{tr}(Z)=\operatorname{tr}(Z^2)=\cdots=\operatorname{tr}(Z^n)=0,
\]
atunci matricea $Z$ este nilpotentă.
\end{lema}

\begin{proof}
Fie $\lambda_1,\dots,\lambda_r$ valorile proprii distincte ale lui $Z$, cu multiplicități $m_1,\dots,m_r$.
Atunci
\[
\operatorname{Tr}(Z^k) = m_1 \lambda_1^k + m_2 \lambda_2^k + \cdots + m_r \lambda_r^k = 0,
\quad k=1,2,\dots,n.
\]

Considerăm primele $r$ ecuații:
\[
\begin{cases}
m_1 \lambda_1 + m_2 \lambda_2 + \cdots + m_r \lambda_r = 0 \\
m_1 \lambda_1^2 + m_2 \lambda_2^2 + \cdots + m_r \lambda_r^2 = 0 \\
\vdots \\
m_1 \lambda_1^r + m_2 \lambda_2^r + \cdots + m_r \lambda_r^r = 0
\end{cases}
\]

Scriem acest sistem sub formă matricială:
\[
\underbrace{
\begin{pmatrix}
1 & 1 & \cdots & 1\\
\lambda_1 & \lambda_2 & \cdots & \lambda_r\\
\lambda_1^2 & \lambda_2^2 & \cdots & \lambda_r^2\\
\vdots & \vdots & & \vdots\\
\lambda_1^{r-1} & \lambda_2^{r-1} & \cdots & \lambda_r^{r-1}
\end{pmatrix}}_{V(\lambda_1,\dots,\lambda_r)\text{ (Vandermonde)}}
\begin{pmatrix}
m_1 \lambda_1 \\ m_2 \lambda_2 \\ \vdots \\ m_r \lambda_r
\end{pmatrix}
=
\begin{pmatrix}
0\\0\\\vdots\\0
\end{pmatrix}.
\]

Determinantul lui Vandermonde
\[
\det V(\lambda_1,\dots,\lambda_r) = \prod_{1\le i<j\le r} (\lambda_j - \lambda_i) \neq 0
\]
deoarece $\lambda_1,\dots,\lambda_r$ sunt distincte.

Rezultă că sistemul admite doar soluția trivială (deoarece putem înmulți la stânga cu inversa matricei Vandermonde $V(\lambda_1,\dots,\lambda_r)$, care este inversabilă)
\[
m_1 \lambda_1 = m_2 \lambda_2 = \cdots = m_r \lambda_r = 0.
\]

Dar $m_j>0$ pentru fiecare $j$, deci \(\lambda_j=0\) pentru toate $j$.

Prin urmare, toate valorile proprii ale lui $Z$ sunt nule și
$Z$ este nilpotentă.
\end{proof}

\begin{proof}[Demonstrația lemei lui Jacobson]
Notăm
\[
C = AB - BA.
\]

Din ipoteză, avem
\[
AC = CA.
\]

Vom demonstra prin inducție matematică afirmația
\[
P(k): \quad AC^k = C^k A.
\]

Pentru $k=1$, afirmația este adevărată deoarece $AC = CA$.
Presupunem că $P(k)$ este adevărată. Înmulțind la dreapta cu $C$, obținem
\[
AC^{k+1} = (AC^k)C = (C^k A)C = C^k (AC) = C^k (CA) = C^{k+1} A,
\]
deci $P(k+1)$ este adevărată. Prin inducție, rezultă că
\[
AC^k = C^k A, \quad \forall k \ge 1.
\]

Observăm acum că
\[
C^k = C^{k-1}C = C^{k-1}(AB-BA) = C^{k-1}AB - C^{k-1}BA
= AC^{k-1}B - C^{k-1}BA.
\]
Prin urmare,
\[
\operatorname{Tr}(C^k)
= \operatorname{Tr}(A C^{k-1} B) - \operatorname{Tr}(C^{k-1} B A).
\]
Folosind proprietatea ciclică a urmei,
\[
\operatorname{Tr}(XY) = \operatorname{Tr}(YX), \quad \forall X,Y \in M_n(\mathbb{C}),
\]
obținem
\[
\operatorname{Tr}(C^k) = \operatorname{Tr}(B A C^{k-1}) - \operatorname{Tr}(B A C^{k-1}) = 0,
\quad \forall k \ge 1.
\]

Prin urmare,
\[
\operatorname{Tr}(C) = \operatorname{Tr}(C^2) = \cdots = \operatorname{Tr}(C^n) = 0.
\]
Conform lemei privind urmele puterilor unei matrice, rezultă că $C$ este nilpotentă.
Astfel, matricea $[A,B]$ este nilpotentă.
\end{proof}









