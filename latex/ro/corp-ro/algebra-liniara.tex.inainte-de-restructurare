\chapter{Matrice de ordinul $n$. Valori şi vectori proprii}

\section{Valori proprii şi vectori proprii pentru matrice pătratice}

Fie $A \in M_n(\mathbb{C})$ o matrice pătratică.

\textbf{Definiţie.} Un număr $\lambda \in \mathbb{C}$ se numeşte \emph{valoare proprie} pentru matricea $A$, dacă există un vector nenul $X \in M_{n,1}(\mathbb{C})$ (matrice coloană) astfel încât:
\[
AX = \lambda X.
\]
Un astfel de vector $X$ se numeşte \emph{vector propriu} pentru matricea $A$ corespunzător valorii proprii $\lambda$.

\textbf{Observaţie.}
\begin{enumerate}
\item O relaţie de forma $AX = \lambda X$, $X \ne O_{n,1}$, unde $A \in M_n(\mathbb{C})$, $\lambda \in \mathbb{C}$, $X \in M_{n,1}(\mathbb{C})$, o numim \emph{relaţie de tip valoare proprie – vector propriu}.
\item Dacă $X_1, X_2$ sunt vectori proprii pentru $A$ corespunzători aceleiași valori proprii $\lambda$, atunci pentru orice $a_1, a_2 \in \mathbb{C}$, vectorul $X = a_1 X_1 + a_2 X_2$, dacă este nenul, este vector propriu pentru $A$ corespunzător lui $\lambda$.

\item Mulţimea tuturor valorilor proprii pentru o matrice $A$ se numeşte \emph{spectrul} matricei $A$ şi se notează cu $\mathrm{Spec}(A)$.
\end{enumerate}

\textbf{Proprietate.} Dacă $A \in M_n(\mathbb{C})$, $\lambda \in \mathbb{C}$ este valoare proprie pentru $A$ iar $X \in M_{n,1}(\mathbb{C})$ este vector propriu corespunzător, atunci:
\begin{enumerate}
\item Pentru orice $k \in \mathbb{C}$, numărul $k\lambda$ este valoare proprie pentru matricea $kA$, iar $X$ este vector propriu pentru $kA$;
\item Pentru orice $k \in \mathbb{N}^*$, numărul $\lambda^k$ este valoare proprie pentru matricea $A^k$, iar $X$ este vector propriu pentru $A^k$;
\item Dacă $A$ este inversabilă, atunci $\lambda \ne 0$ (o matrice inversabilă nu are valoarea proprie $0$) şi numărul $\frac{1}{\lambda}$ este valoare proprie pentru matricea $A^{-1}$, iar $X$ este vector propriu pentru $A^{-1}$.
\end{enumerate}

\textbf{Demonstraţie.}
\begin{enumerate}
\item Din $AX = \lambda X$, rezulta $(kA)X = (k\lambda )X$
\item Procedăm prin inducție după $k$. Pentru $k=1$: $AX=\lambda X$.  
Dacă $A^nX=\lambda^n X$, înmulțim cu $A$ la stânga:
\[
A^{n+1}X=A\lambda^n X=\lambda^n AX=\lambda^n \lambda X=\lambda^{n+1}X.
\]



\item Dacă $A$ e inversabilă şi $AX = \lambda X$, atunci $A^{-1} A X = A^{-1} \lambda X$, adică $X = \lambda A^{-1} X$, deci $A^{-1} X = \frac{1}{\lambda} X$.
\end{enumerate}

\textbf{Observaţii.}
\begin{enumerate}
\item Afirmaţiile de mai sus admit parţial reciproce:
\begin{itemize}
\item Singurele valori proprii ale lui $kA$ sunt de forma $k\lambda$, unde $\lambda$ este valoare proprie pentru $A$.
\item Singurele valori proprii ale lui $A^k$ sunt de forma $\lambda^k$.
\item Singurele valori proprii ale lui $A^{-1}$ sunt de forma $\frac{1}{\lambda}$.
\end{itemize}
\item În definiţia dată, noţiunile de valori proprii şi vectori proprii sunt definite simultan. Se poate da o definiţie independentă pentru valorile proprii, după cum reiese din următoarea:
\end{enumerate}

\begin{teorema}
Un număr $\lambda \in \mathbb{C}$ este valoare proprie pentru matricea $A \in M_n(\mathbb{C})$ dacă şi numai dacă:
\[
\det(\lambda I_n - A) = 0.
\]
\end{teorema}

\textbf{Demonstrație.} Relația $AX = \lambda X$ se poate scrie $(\lambda I_n - A) X = O_{n,1}$, $X \ne O_{n,1}$, ceea ce echivalează cu faptul că sistemul de ecuații omogen $(\lambda I_n - A) X = 0$ are soluții nebanale, adică determinantul matricei coeficienților este zero.

\section{Polinomul caracteristic al unei matrice pătratice}

Fie $A \in M_n(\mathbb{C})$.

\textbf{Definiţie.}
\begin{enumerate}
\item Matricea $X I_n - A$ se numește \emph{matrice caracteristică} a lui $A$;
\item Polinomul $f_A(X) = \det(X I_n - A)$ se numește \emph{polinom caracteristic} al lui $A$; el este monic, de grad $n$, și îl vom nota și cu $p_A$. În tot volumul folosim această convenție. Deoarece $\det(A - X I_n) = (-1)^n f_A(X)$, cele două variante au aceleași rădăcini;
\item Ecuaţia $f_A(x) = 0$ se numeşte \emph{ecuaţia caracteristică} a matricei $A$.
\end{enumerate}

\begin{observatie}
Valorile proprii ale matricei $A$ sunt rădăcinile polinomului caracteristic.
\end{observatie}

\begin{propozitie}
Dacă $A \in M_n(\mathbb{C})$, atunci:
\[
f_A(X) = X^n - \sigma_1 X^{n-1} + \sigma_2 X^{n-2} - \dots + (-1)^n \sigma_n
\]
unde $\sigma_k$ este suma tuturor minorilor diagonali de ordin $k$ din $A$.
\end{propozitie}

\begin{observatie}
Dintre coeficienţii polinomului caracteristic remarcăm:
\[
\sigma_1 = \mathrm{Tr}(A) = \sum_{i=1}^n a_{ii}, \quad \sigma_n = \det(A). \quad \sigma_{n-1} = \text{tr}(\adj(A)). 
\]
\end{observatie}

\begin{teorema}[Viète]
Dacă valorile proprii ale lui $A$ sunt $\lambda_1, \dots, \lambda_n$, atunci:
\[
f_A(X) = (X - \lambda_1)(X - \lambda_2)\dots(X - \lambda_n),
\]
iar coeficienţii $\sigma_k$ satisfac:
\[
\sigma_k = S_k = \sum_{1 \le i_1 < \dots < i_k \le n} \lambda_{i_1}\lambda_{i_2}\dots\lambda_{i_k}.
\]
În particular:
\[
\mathrm{Tr}(A) = \sum_{i=1}^n \lambda_i, \qquad \det(A) = \prod_{i=1}^n \lambda_i.\qquad \mathrm{Tr}(\adj(A))= \sum_{i=1}^{n} \prod_{j \neq i} \lambda_j
\]
\end{teorema}

\textbf{Definiție.}  
Fie $A, B \in M_n(\mathbb{K})$.  
Se spune că $A$ și $B$ sunt \emph{asemenea} dacă există o matrice inversabilă 
$P \in GL_n(\mathbb{K})$ astfel încât
\[
B = P^{-1} A P.
\]
\textbf{Proprietate.} Două matrice asemenea au același polinom caracteristic. Într-adevăr,
$\det(X I_n - P^{-1} A P) = \det\big(P^{-1}(X I_n - A)P\big) = \det(X I_n - A)$.

\begin{propozitie}
Dacă $A,B$ sunt matrice pătratice, atunci polinoamele caracteristice ale lui $AB$ şi $BA$ coincid.
\end{propozitie}

\begin{propozitie}
Dacă $A \in M_{n,m}(\mathbb{C})$ și $B \in M_{m,n}(\mathbb{C})$, cu $m \ge n$, atunci între polinoamele caracteristice există relația:
\[
X^{m-n} f_{AB}(X) = f_{BA}(X).
\]
\end{propozitie}

\begin{teorema}[Cayley și Hamilton]
Fie $A \in M_n(\mathbb{C})$ și fie $p_A(X) = \det(X I_n - A)$ polinomul caracteristic al lui $A$.
Atunci matricea $A$ satisface propriul polinom caracteristic, adică
\[
p_A(A)=O_n.
\]
\end{teorema}

\section{Matrice remarcabile şi valori proprii}


Reamintim că pentru o matrice $A \in M_n(\mathbb{C})$, $A = (a_{ij})_{1 \le i,j \le n}$, definim 
matricea adjunctă $A^* = \overline{A}^t = (\overline{a_{ji}})_{1 \le i,j \le n}$.

O matrice $A \in M_n(\mathbb{C})$ se numeşte:
\begin{itemize}
\item[a)] \textbf{autoadjunctă (hermitiană)}, dacă $A^* = A$;
\item[b)] \textbf{antiautoadjunctă (antihermitiană)}, dacă $A^* = -A$;
\item[c)] \textbf{unitară}, dacă $A^* \cdot A = I_n$ (adică $A^* = A^{-1}$).


\end{itemize}

În cazul când $A \in M_n(\mathbb{R})$, se folosesc denumirile:
\begin{itemize}
\item[a)] \textbf{simetrică}, dacă $A^t = A$ (deoarece $A^* = A^t$);
\item[b)] \textbf{antisimetrică}, dacă $A^t = -A$;
\item[c)] \textbf{ortogonală}, dacă $A^t \cdot A = I_n$ (adică $A^t = A^{-1}$).
\end{itemize}



Se pot da câteva rezultate generale asupra valorilor proprii ale matricelor remarcabile.  
Astfel, pentru doi vectori $X, Y \in M_{n,1}(\mathbb{C})$,
\[
X = 
\begin{pmatrix}
x_1 \\ x_2 \\ \vdots \\ x_n
\end{pmatrix}, \quad
Y =
\begin{pmatrix}
y_1 \\ y_2 \\ \vdots \\ y_n
\end{pmatrix},
\]
definim produsul scalar
\[
\langle X, Y \rangle = \sum_{k=1}^n x_k \overline{y_k}=\overline{Y^T}X.
\]

Se verifică uşor relaţiile:
\begin{enumerate}
\item $\langle X + Y, Z \rangle = \langle X, Z \rangle + \langle Y, Z \rangle$,
\item $\langle X, Y \rangle = \overline{\langle Y, X \rangle}$,
\item $\langle aX, Y \rangle = a \langle X, Y \rangle$,
\item $\langle X, aY \rangle = \overline{a} \langle X, Y \rangle$,
\item $\langle X, X \rangle \ge 0$ şi $\langle X, X \rangle = 0 \iff X = 0$.
\end{enumerate}

Relaţiile au loc pentru orice $X, Y, Z \in M_{n,1}(\mathbb{C})$, $a \in \mathbb{C}$. 

\begin{observatie}
Dacă $A \in M_n(\mathbb{C})$, atunci
\[
\langle A X, Y \rangle = \langle X, A^* Y \rangle,
\]
pentru orice $X, Y \in M_{n,1}(\mathbb{C})$.
Adică: $\overline{Y^T}AX=\overline{(A^*Y)^T}\,X$, deoarece $\overline{(A^*Y)^T} = \overline{Y^T}\,\overline{(A^*)^T} = \overline{Y^T}A$.
\end{observatie}

Într-adevăr,
\[
\langle A X, Y \rangle = \sum_{p=1}^n \sum_{k=1}^n a_{pk} x_k \overline{y_p} = 
\sum_{k=1}^n x_k \overline{\sum_{p=1}^n \overline{a_{pk}}\, y_p} = \langle X, A^* Y \rangle,
\]
deoarece elementul de pe poziția $(k,p)$ al lui $A^*$ este $\overline{a_{pk}}$.

\begin{propozitie}
Toate valorile proprii ale unei matrice hermitiene sunt numere reale.
\end{propozitie}

\textit{Demonstraţia 1.}  
Fie $\lambda \in \mathbb{C}$ valoare proprie şi $X \ne 0$ vector propriu, deci $A X = \lambda X$.  
Avem:
\[
\langle A X, X \rangle = \langle X, A^* X \rangle = \langle X, A X \rangle = \langle X, \lambda X \rangle = \overline{\lambda} \langle X, X \rangle,
\]
dar și
\[
\langle A X, X \rangle = \langle \lambda X, X \rangle = \lambda \langle X, X \rangle,
\]
de unde rezultă $\lambda = \overline{\lambda}$, adică $\lambda \in \mathbb{R}$.

\textit{Demonstraţia 2.}  
Fie $A \in M_n(\mathbb{C})$ matrice hermitiană, deci $A^* = A$.
Fie $\lambda \in \mathbb{C}$ valoare proprie şi $X \neq 0$ vector propriu, astfel încât
\[
AX = \lambda X.
\]

Conjugăm relaţia:
\[
\overline{AX} = \overline{\lambda X}.
\]

Transpunem:
\[
\overline{X^T A^T} = \overline{\lambda}\,\overline{X}^T.
\]
Dar $\overline{X}^T = \overline{X^T}$ şi $A = \overline{A^T}$ deoarece $A^* = A$, deci
\[
\overline{X^T}A = \overline{\lambda}\,\overline{X^T}.
\]

Înmulţind la dreapta cu $X$, obţinem:
\[
\overline{X^T}AX = \overline{\lambda}\,\overline{X^T}X.
\]
Pe de altă parte, din $AX = \lambda X$ rezultă
\[
\overline{X^T}(AX) = \lambda\,\overline{X^T}X.
\]
Prin urmare,
\[
\lambda\,\overline{X^T}X = \overline{\lambda}\,\overline{X^T}X.
\]
Cum $\overline{X^T}X > 0$ (deoarece $X \neq 0$), rezultă
\[
\lambda = \overline{\lambda},
\]
deci $\lambda \in \mathbb{R}$.
\hfill $\square$



\begin{propozitie}
Toate valorile proprii ale unei matrici antihermitiene sunt numere imaginare pure (cu partea reală zero).
\end{propozitie}

\textit{Demonstraţia 1.}  
Fie $A X = \lambda X$, $X \ne 0$.  
Atunci
\[
\langle A X, X \rangle = \langle X, A^* X \rangle = \langle X, -A X \rangle = - \overline{\lambda} \langle X, X \rangle,
\]
iar pe de altă parte $\langle A X, X \rangle = \lambda \langle X, X \rangle$. Cum $\langle X, X \rangle > 0$, rezultă $\lambda = -\overline{\lambda}$, deci $\lambda = i b$, $b \in \mathbb{R}$.

\textit{Demonstratia 2.}
Fie $A \in M_n(\mathbb{C})$ matrice antihermitiană, deci $A^* = -A$.
Fie $AX = \lambda X$, cu $X \neq 0$.

Conjugăm:
\[
\overline{AX} = \overline{\lambda X}
\quad \Rightarrow \quad
\overline{A}\,\overline{X} = \overline{\lambda}\,\overline{X}.
\]
Transpunem:
\[
\overline{X^T A^T} = \overline{\lambda}\,\overline{X}^T.
\]
Cum $-A = \overline{A^T}$, rezultă
\[
\overline{X^T}A = -\overline{\lambda}\,\overline{X^T}.
\]

Înmulţind la dreapta cu $X$:
\[
\overline{X^T}AX = -\overline{\lambda}\,\overline{X^T}X.
\]
Dar din relaţia iniţială avem
\[
\overline{X^T}AX = \lambda\,\overline{X^T}X.

\]
Rezultă
\[
\lambda = -\overline{\lambda}.
\]
Aceasta implică $\Re(\lambda)=0$, deci
\[
\lambda = ib,\quad b \in \mathbb{R}.
\]
\hfill $\square$

\begin{propozitie}
Toate valorile proprii ale unei matrici unitare au modulul egal cu $1$.
\end{propozitie}

\textit{Demonstraţia 1.}  
Fie $A X = \lambda X$, $X \ne 0$.  
Atunci
\[
\langle A X, A X \rangle = \langle X, A^* A X \rangle = \langle X, X \rangle.
\]
Dar $\langle A X, A X \rangle = |\lambda|^2 \langle X, X \rangle$, de unde $|\lambda| = 1$.

\textit{Demonstraţia 2.}
Fie $A \in M_n(\mathbb{C})$ o matrice unitară, deci care verifica $A^*A = I_n$.

Conjugăm şi transpunem relaţia $AX = \lambda X$:
\[
\overline{X^T}A^* = \overline{\lambda}\,\overline{X^T}.
\]

Înmulţind la dreapta cu $AX$, obţinem:
\[
\overline{X^T}A^*AX = \overline{\lambda}\,\overline{X^T}AX.
\]
Dar $A^*A = I_n$, deci
\[
\overline{X^T}X = \overline{\lambda}\,\lambda\,\overline{X^T}X.
\]
Rezultă
\[
|\lambda|^2 = 1,
\quad \text{deci} \quad
|\lambda| = 1.
\]
\hfill $\square$




\textbf{Observaţii 2.2.16.}
\begin{enumerate}
\item Dacă $A \in M_n(\mathbb{R})$ și $A^t = A$, atunci ecuația $\det(x I_n - A) = 0$ are toate rădăcinile reale.
\item Dacă $A \in M_n(\mathbb{R})$ și $A^t = -A$, atunci ecuația $\det(x I_n - A) = 0$ are toate rădăcinile de forma $\lambda = i b$, $b \in \mathbb{R}$ (au partea reală zero).
\item Dacă $A \in M_n(\mathbb{R})$ este inversabilă și $A^t = A^{-1}$, atunci ecuația $\det(x I_n - A) = 0$ are toate rădăcinile de forma $\lambda = e^{i \alpha} = \cos \alpha + i \sin \alpha$, $\alpha \in \mathbb{R}$ (rădăcinile complexe se cuplează în perechi conjugate, iar cele reale sunt $1$ sau $-1$).
\end{enumerate}

\section{Polinomul minimal al unei matrice}

Fie $K = \mathbb{R}, \mathbb{C}$ sau $\mathbb{Q}$ şi $A \in M_n(K)$. Există polinoame nenule din $K[X]$ care admit pe $A$ ca rădăcină, de exemplu $p_A$.

\begin{propozitie}
Fie $f$ un polinom de grad minim printre polinoamele nenule din $K[X]$ care admit pe $A$ ca rădăcină.  
Pentru orice $g \in K[X]$ care admite pe $A$ ca rădăcină, există $q \in K[X]$ astfel încât $g = f \cdot q$, adică $f$ divide în $K[X]$ pe $g$.
\end{propozitie}

\textbf{Demonstrație.}  
Fie $q, r \in K[X]$ astfel încât $g = f \cdot q + r$, cu $\deg(r) < \deg(f)$.  
Luând valoarea în $A$ a polinoamelor din egalitatea precedentă, obţinem $r(A) = 0$.  
Dacă $r \neq 0$, se contrazice alegerea lui $f$. Aşadar, $r = 0$, deci $g = f \cdot q$.

Fie 
\[
f(X) = a_d X^d + a_{d-1} X^{d-1} + \dots + a_0, \quad a_d \neq 0,
\]
polinomul din enunţul propoziţiei de mai sus. Polinomul $f_1 = a_d^{-1} f$ admite, de asemenea, pe $A$ ca rădăcină, este monic şi are acelaşi grad $d$.

Dacă $f_1$ şi $f_2$ sunt două polinoame monice de grad $d$ din $K[X]$ care admit pe $A$ ca rădăcină, atunci $f_1 = f_2$.  
Într-adevăr, conform propoziţiei demonstrate, $f_1$ şi $f_2$ se divid reciproc în $K[X]$, iar fiind monice se deduce imediat că $f_1 = f_2$.

\textbf{Definiţia 2.3.13.}  
Fie $K = \mathbb{R}, \mathbb{C}$ sau $\mathbb{Q}$ şi $A \in M_n(K)$.  
Polinomul monic $m_A$ de grad minim din $K[X]$ care admite pe $A$ ca rădăcină se numeşte \emph{polinomul minimal al lui $A$}.

\textbf{Exemplul 2.3.14.}  
Fie $A \in M_3(\mathbb{R})$, 
\[
A = 
\begin{pmatrix}
-1 & 0 & 0 \\
0 & 0 & 1 \\
0 & 1 & 0
\end{pmatrix}.
\]

Polinomul caracteristic al lui $A$ este:
\[
p_A(X) = \det(XI_3 - A) = (X + 1)(X^2 - 1) = (X + 1)(X - 1)^2.
\]

Divizorii lui $p_A(X)$ sunt:
\[
1, \quad X - 1, \quad X + 1, \quad (X - 1)^2, \quad (X - 1)(X + 1) = X^2 - 1, \quad (X - 1)^2(X + 1).
\]

Polinomul $m_A(X)$ va fi polinomul de grad minim din lista de mai sus care admite pe $A$ ca rădăcină.  
Cum $A^2 = I_3$, rezultă că $X^2 - 1$ admite pe $A$ ca rădăcină, iar $1$, $X - 1$ și $X + 1$ nu admit pe $A$ ca rădăcină.  
Prin urmare, 
\[
m_A(X) = X^2 - 1.
\]

\begin{corolar}
Fie $K = \mathbb{R}, \mathbb{C}$ sau $\mathbb{Q}$ şi $A \in M_n(K)$.  
Atunci $m_A$ divide în $K[X]$ pe $p_A$, adică polinomul minimal este un divizor al polinomului caracteristic.  
Dacă $d_A = \deg(m_A)$, atunci $d_A \le n$.
\end{corolar}



\textbf{Teorema 2.3.16. (Frobenius)}  

Fie $K \in \{\mathbb{C}, \mathbb{R}, \mathbb{Q}\}$ şi $A \in M_n(K)$.  
Polinoamele $p_A$ şi $m_A$ admit aceiaşi divizori ireductibili peste $K$.

\textbf{Demonstraţie.}  
Cum $m_A$ divide pe $p_A$ (conform corolarului precedent), este clar că orice divizor ireductibil al lui $m_A$ este şi al lui $p_A$.  
Rămâne de arătat că, dacă $f$ este un divizor ireductibil peste $K$ al lui $p_A$, atunci $f$ este divizor şi al lui $m_A$.  
Evident, putem presupune că $f$ este monic.  

Cum $\deg f \ge 1$, conform teoremei fundamentale a algebrei există $\alpha \in \mathbb{C}$ cu $f(\alpha) = 0$. (În general $\alpha \notin K$: pentru $K = \mathbb{R}$ și $f = X^2 + 1$ avem $\alpha = \pm i$. De aceea lucrăm în $\mathbb{C}$.)

\emph{Pasul 1: $m_A(\alpha) = 0$.} Cum $f$ divide pe $p_A$, avem $p_A(\alpha) = 0$, deci $\det(\alpha I_n - A) = 0$ și $\alpha$ este valoare proprie a lui $A$, privită ca matrice din $M_n(\mathbb{C})$. Există deci $X \in M_{n,1}(\mathbb{C})$, $X \neq 0$, cu $AX = \alpha X$. Atunci $A^k X = \alpha^k X$ pentru orice $k \in \mathbb{N}$, deci $g(A) X = g(\alpha) X$ pentru orice polinom $g$. Pentru $g = m_A$ obținem
\[
0 = m_A(A) X = m_A(\alpha) X,
\]
iar cum $X \neq 0$, rezultă $m_A(\alpha) = 0$.

\emph{Pasul 2: $f$ divide pe $m_A$ în $K[X]$.} Presupunem contrariul. Cum $f$ este ireductibil în $K[X]$, orice divizor comun al lui $f$ și $m_A$ din $K[X]$ este fie o constantă nenulă, fie o constantă înmulțită cu $f$; al doilea caz ar da $f \mid m_A$. Deci $f$ și $m_A$ sunt prime între ele în $K[X]$ și, conform teoremei lui Bézout, există $u, v \in K[X]$ cu
\[
u(X) f(X) + v(X) m_A(X) = 1.
\]
Evaluând în $X = \alpha$ obținem $0 = 1$, contradicție. Prin urmare $f$ divide pe $m_A$.

\begin{observatie}
Un alt argument care permite demonstrarea teoremei se bazează pe faptul că din $p_A(A) = 0$ rezultă că pentru orice valoare proprie $\lambda$ a lui $A$, $p_A(\lambda) = 0$.  
Cum $m_A(A) = 0$, rezultă că $m_A(\lambda) = 0$ pentru orice valoare proprie $\lambda$ a matricei $A$.  
Prin urmare, $m_A$ şi $p_A$ au aceleaşi rădăcini, diferind eventual doar prin ordinul de multiplicitate.

Mai mult, fiecare valoare proprie $\lambda$ este rădăcină a polinomului $f_A \in K[X]$; fie $g_\lambda \in K[X]$ polinomul monic de grad minim din $K[X]$ cu $g_\lambda(\lambda) = 0$. Ca în demonstrația de la polinomul minimal al unui număr algebric, $g_\lambda$ divide orice polinom din $K[X]$ care se anulează în $\lambda$, deci $g_\lambda$ este factor atât în $m_A$, cât și în $p_A$.
\end{observatie}









\begin{lema}
Fie \(A,B\in M_n(\mathbb{C})\). Funcţia
\[
f:\mathbb{C}\times\mathbb{C}\to\mathbb{C},\qquad f(x,y)=\det(xA+yB)
\]
este un polinom omogen de gradul \(n\) în variabilele \(x,y\), adică există coeficienţi \(\alpha_0,\alpha_1,\dots,\alpha_n\in\mathbb{C}\) astfel încât
\[
\det(xA+yB)=\sum_{k=0}^n \alpha_k\,x^{\,n-k}y^{\,k}.
\]
Coeficientul \(\alpha_k\) este suma tuturor determinantelor matricei obţinute luând, pentru fiecare alegere a unui subset \(S\subset\{1,\dots,n\}\) cu \(|S|=k\), matricea care are liniile indexate de \(S\) luate din \(B\) iar celelalte \(n-k\) linii luate din \(A\). În particular
\[
\alpha_0=\det A,\qquad \alpha_n=\det B,
\]
iar pentru \(A^*=\operatorname{adj}(A)\) (matricea adujată a lui \(A\)) avem
\[
\alpha_1=\operatorname{Tr}(A^*B),\qquad \alpha_{\,n-1}=\operatorname{Tr}(B^*A).
\]
\end{lema}

\begin{proof}
Aplicăm formula lui Leibniz la matricea \(M(x,y):=xA+yB\). Pentru orice permutare \(\sigma\in S_n\) avem
\[
\prod_{i=1}^n M_{i,\sigma(i)}=\prod_{i=1}^n\bigl(x a_{i,\sigma(i)}+ y b_{i,\sigma(i)}\bigr).
\]
Prin urmare
\[
\det(xA+yB)=\sum_{\sigma\in S_n}\operatorname{sgn}(\sigma)\prod_{i=1}^n\bigl(x a_{i,\sigma(i)}+ y b_{i,\sigma(i)}\bigr).
\]

Extindem produsul pentru fiecare \(\sigma\): pentru fiecare submulțime \(S\subset\{1,\dots,n\}\) se obține un termen în care am ales factorul \(y b_{i,\sigma(i)}\) pentru \(i\in S\) și \(x a_{i,\sigma(i)}\) pentru \(i\notin S\). Astfel fiecare astfel de termen este
\[
x^{\,n-|S|}y^{\,|S|}\prod_{i\notin S} a_{i,\sigma(i)}\prod_{i\in S} b_{i,\sigma(i)}.
\]
Grupând după puterea lui \(y\) obținem forma dorită
\[
\det(xA+yB)=\sum_{k=0}^n x^{\,n-k}y^{\,k}
\underbrace{\sum_{\substack{S\subset\{1,\dots,n\}\\|S|=k}}
\;\sum_{\sigma\in S_n}\operatorname{sgn}(\sigma)\prod_{i\notin S}a_{i,\sigma(i)}\prod_{i\in S}b_{i,\sigma(i)}}_{=: \alpha_k}.
\]
Aceasta definește \(\alpha_k\) ca sumă brută peste submulțimi și permutări; din definiție imediat rezultă \(\alpha_0=\det A\) și \(\alpha_n=\det B\).
Rămâne să arătăm că
\[
\alpha_{n-1}=\operatorname{Tr}(B^*A).
\]

Prin definiție,
\[
\alpha_{n-1}
=
\sum_{\substack{S\subset\{1,\dots,n\}\\ |S|=n-1}}
\;\sum_{\sigma\in S_n}\operatorname{sgn}(\sigma)
\prod_{i\notin S} a_{i,\sigma(i)}\prod_{i\in S} b_{i,\sigma(i)}.
\]

O submulțime $S$ cu $|S|=n-1$ este de forma
\[
S=\{1,\dots,n\}\setminus\{j\},
\]
pentru un unic $j\in\{1,\dots,n\}$.
Prin urmare,
\[
\alpha_{n-1}
=
\sum_{j=1}^n
\sum_{\sigma\in S_n}\operatorname{sgn}(\sigma)\,
a_{j,\sigma(j)}\prod_{i\neq j} b_{i,\sigma(i)}.
\]

\[
=
\sum_{j=1}^n
\sum_{k=1}^n
a_{j k}
\sum_{\substack{\sigma\in S_n\\ \sigma(j)=k}}
\operatorname{sgn}(\sigma)
\prod_{i\neq j} b_{i,\sigma(i)}.
\]

\[
=
\sum_{j=1}^n\sum_{k=1}^n a_{jk}(B^*)_{k j}
=
\operatorname{Tr}(B^*A).
\]

\hfill $\square$\newline
\medskip
\noindent\textbf{Observație.}
Pentru orice $A,B\in M_2(\mathbb C)$ are loc identitatea
\begin{equation}\label{eq:trace-adj-2x2}
\operatorname{Tr}(\operatorname{adj}A\,B)
=\operatorname{Tr}(A)\operatorname{Tr}(B)-\operatorname{Tr}(AB).
\end{equation}

\medskip
\noindent
Într-adevăr, dacă $A$ este inversabilă, din teorema Cayley--Hamilton rezultă
\[
A^2-\operatorname{Tr}(A)\,A+\det(A)\,I_2=0.
\]
Înmulțind la dreapta cu $A^{-1}$, obținem
\[
\det(A)\,A^{-1}=\operatorname{Tr}(A)\,I_2-A,
\]
adică
\[
\operatorname{adj}A=\operatorname{Tr}(A)\,I_2-A.
\]

\medskip
\noindent
Relația rămâne valabilă și pentru $A$ neînversabilă, prin continuitate, deoarece
ambele membre sunt polinoame în coeficienții lui $A$.

\medskip
\noindent
Pentru $B\in M_2(\mathbb C)$ arbitrar, avem
\[
\operatorname{adj}A\,B
=(\operatorname{Tr}(A)\,I_2-A)B
=\operatorname{Tr}(A)\,B-AB.
\]
Aplicând urma și folosind liniaritatea acesteia, rezultă din nou
\[
\operatorname{Tr}(\operatorname{adj}A\,B)
=\operatorname{Tr}(A)\operatorname{Tr}(B)-\operatorname{Tr}(AB).
\]



\end{proof}

