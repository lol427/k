\chapter{Matrice pe blocuri și transformări elementare}\label{ch:blocuri}

\subsection{Matrici pe blocuri}
Fie $A\in M_{m,n}(K)$ şi partiţiile
$m=m_1+\dots+m_q$, $n=n_1+\dots+n_p$. Atunci
\[
A=
\begin{pmatrix}
A_{11} & A_{12} & \cdots & A_{1p}\\[4pt]
A_{21} & A_{22} & \cdots & A_{2p}\\[4pt]
\vdots & \vdots & \ddots & \vdots\\[4pt]
A_{q1} & A_{q2} & \cdots & A_{qp}
\end{pmatrix},
\qquad A_{ij}\in M_{m_i,n_j}(K).
\]

\subsection{Operații cu matrici pe blocuri}

Fie matricile
\[
A=
\begin{pmatrix}
A_{11} & A_{12}\\
A_{21} & A_{22}
\end{pmatrix},
\qquad
B=
\begin{pmatrix}
B_{11} & B_{12}\\
B_{21} & B_{22}
\end{pmatrix},
\]
unde blocurile sunt compatibile dimensional.

\subsection{Adunarea}
Adunarea se face bloc cu bloc:
\[
A+B=
\begin{pmatrix}
A_{11}+B_{11} & A_{12}+B_{12}\\
A_{21}+B_{21} & A_{22}+B_{22}
\end{pmatrix}.
\]

\subsection{Înmulțirea cu scalar}
Pentru $\lambda\in K$:
\[
\lambda A=
\begin{pmatrix}
\lambda A_{11} & \lambda A_{12}\\
\lambda A_{21} & \lambda A_{22}
\end{pmatrix}.
\]

\subsection{Înmulțirea matricilor}
Produsul se calculează conform regulii uzuale:
\[
AB=
\begin{pmatrix}
A_{11}B_{11}+A_{12}B_{21} & A_{11}B_{12}+A_{12}B_{22}\\
A_{21}B_{11}+A_{22}B_{21} & A_{21}B_{12}+A_{22}B_{22}
\end{pmatrix}.
\]

\subsection{Rangul unei matrici bloc-diagonale}

\begin{propozitie}
Fie matricea bloc-diagonală
\[
D=
\begin{pmatrix}
A_1 & 0 & \cdots & 0\\
0 & A_2 & \cdots & 0\\
\vdots & \vdots & \ddots & \vdots\\
0 & 0 & \cdots & A_k
\end{pmatrix},
\]
unde $A_i\in M_{m_i,n_i}(K)$. Atunci
\[
\rang(D)=\rang(A_1)+\rang(A_2)+\cdots+\rang(A_k).
\]
\end{propozitie}



\subsection{Determinantul matricei bloc-triunghiulară}

\begin{corolar}
Pentru matricea
\[
T=
\begin{pmatrix}
A_1 & * & \cdots & *\\
0 & A_2 & \cdots & *\\
\vdots & \vdots & \ddots & \vdots\\
0 & 0 & \cdots & A_k
\end{pmatrix},
\]
unde $A_i\in M_{n_i}(K)$, avem
\[
\det(T)=\prod_{i=1}^k \det(A_i).
\]
\end{corolar}

\begin{proof}
Tratăm întâi cazul a două blocuri. Fie
\[
T=
\begin{pmatrix}
A_1 & B\\
0 & C
\end{pmatrix},
\qquad A_1 \in M_p(K),\ C \in M_q(K),\ B \in M_{p,q}(K).
\]
Prin înmulțirea pe blocuri se verifică imediat că
\[
T=
\begin{pmatrix}
I_p & 0\\
0 & C
\end{pmatrix}
\begin{pmatrix}
A_1 & B\\
0 & I_q
\end{pmatrix}.
\]
Dezvoltând primul determinant succesiv după primele $p$ linii (fiecare are un singur element nenul, egal cu $1$, pe diagonală), obținem $\det C$. Dezvoltând al doilea determinant succesiv după ultimele $q$ linii (fiecare are un singur element nenul, egal cu $1$, pe diagonală), obținem $\det A_1$. Deci $\det T = \det A_1 \cdot \det C$.

În cazul general, procedăm prin inducție după $k$: scriem
\[
T=
\begin{pmatrix}
A_1 & *\\
0 & T'
\end{pmatrix},
\]
unde $T'$ este matricea bloc-triunghiulară cu blocurile diagonale $A_2,\dots,A_k$. Din cazul a două blocuri, $\det T = \det A_1 \cdot \det T'$, iar din ipoteza de inducție $\det T' = \prod_{i=2}^k \det A_i$.
\end{proof}
\section{Transformări elementare ale matricelor}

Transformările elementare pe rânduri (respectiv pe coloane) sunt operații fundamentale care nu modifică rangul unei matrice. Fie
\[
A \in M_{n \times m}(K).
\]
Vrem sa inmultim matricea $A$ cu o matrice  $E$ care sa efectueze aceste transformari.
Matricele $E$ se numesc matrici elementare.Toate matricile elementare sunt inversabile, iar acest fapt implică
\[
\rang(EA) = \rang(A), \qquad \rang(AE) = \rang(A).
\]

\subsection{Tipurile de transformări elementare și matricile asociate}

\subsection{Schimbarea a două rânduri(coloane) $i$ și $j$ $(i \neq j)$}

Matricea de transformare este matricea de permutare
\[
P_{ij} = (p_{kl})_{1 \le k,l \le n}, \qquad
p_{kl} =
\begin{cases}
1, & k = l,\; k \notin \{i,j\}, \\
1, & (k,l) = (i,j) \text{ sau } (k,l) = (j,i), \\
0, & \text{altfel}.
\end{cases}
\]

Aceasta se obține din matricea identitate $I_n$ prin permutarea liniilor $i$ și $j$.
Inversa sa este
\[
P_{ij}^{-1} = P_{ij}.
\]


\[
P_{ij} =
\begin{pmatrix}
1 & 0 & \cdots & 0 & \cdots & 0 & \cdots & 0 \\
0 & 1 & \cdots & 0 & \cdots & 0 & \cdots & 0 \\
\vdots & \vdots & \ddots & \vdots &        & \vdots &        & \vdots \\
0 & 0 & \cdots & 0 & \cdots & 1 & \cdots & 0 \\
\vdots & \vdots &        & \vdots & \ddots & \vdots &        & \vdots \\
0 & 0 & \cdots & 1 & \cdots & 0 & \cdots & 0 \\
\vdots & \vdots &        & \vdots &        & \vdots & \ddots & \vdots \\
0 & 0 & \cdots & 0 & \cdots & 0 & \cdots & 1
\end{pmatrix}
\]


\subsection{Înmulțirea rândului(coloanei) $i$ cu un scalar $\alpha \neq 0$}

Matricea de transformare este o matrice diagonală
\[
D_i(\alpha) = (d_{kl})_{1 \le k,l \le n}, \qquad
d_{kl} =
\begin{cases}
\alpha, & k = l = i, \\
1, & k = l \neq i, \\
0, & k \neq l.
\end{cases}
\]

Aceasta corespunde multiplicării rândului $i$ cu $\alpha$.
Inversa este
\[
D_i(\alpha)^{-1} = D_i\!\left(\frac{1}{\alpha}\right).
\]


\[
D_i(\alpha) =
\begin{pmatrix}
1 & 0 & \cdots & 0 & \cdots & 0 \\
0 & 1 & \cdots & 0 & \cdots & 0 \\
\vdots & \vdots & \ddots & \vdots &        & \vdots \\
0 & 0 & \cdots & \alpha & \cdots & 0 \\
\vdots & \vdots &        & \vdots & \ddots & \vdots \\
0 & 0 & \cdots & 0 & \cdots & 1
\end{pmatrix}
\]


\subsection{Adunarea unui multiplu al rândului(coloanei) $j$ la rândul(coloana) $i$, $i \neq j$}

Matricea de transformare este
\[
E_{ij}(\alpha) = (e_{kl})_{1 \le k,l \le n}, \qquad
e_{kl} =
\begin{cases}
1, & k = l, \\
\alpha, & (k,l) = (i,j), \\
0, & \text{altfel}.
\end{cases}
\]

Aceasta realizează operația
\[
R_i \leftarrow R_i + \alpha R_j.
\]
Inversa este
\[
E_{ij}(\alpha)^{-1} = E_{ij}(-\alpha).
\]

\[
E_{ij}(\alpha)=
\begin{pmatrix}
1 & 0 & \cdots & 0 & \cdots & 0 & \cdots & 0 \\
0 & 1 & \cdots & 0 & \cdots & 0 & \cdots & 0 \\
\vdots & \vdots & \ddots & \vdots &        & \vdots &        & \vdots \\
0 & 0 & \cdots & 1 & \cdots & \alpha & \cdots & 0 \\
\vdots & \vdots &        & \vdots & \ddots & \vdots &        & \vdots \\
0 & 0 & \cdots & 0 & \cdots & 1 & \cdots & 0 \\
\vdots & \vdots &        & \vdots &        & \vdots & \ddots & \vdots \\
0 & 0 & \cdots & 0 & \cdots & 0 & \cdots & 1
\end{pmatrix}
\]





Fie \(A \in M_{m,n}(\mathbb{C})\).

\section{Înmulțirea la stânga cu o matrice elementară}

Dacă \(E \in M_m(\mathbb{C})\) este o matrice elementară, atunci
\[
EA \in M_{m,n}(\mathbb{C})
\]
corespunde aplicării unei transformări elementare asupra rândurilor matricei \(A\):
\begin{itemize}
\item \(P_{ij}A\) schimbă rândurile \(i\) și \(j\) ale matricei \(A\);
\item \(D_i(\alpha)A\) înmulțește rândul \(i\) al lui \(A\) cu scalarul \(\alpha\);
\item \(E_{ij}(\alpha)A\) realizează operația \(R_i \leftarrow R_i + \alpha R_j\).
\end{itemize}

Fiecare rând al produsului \(EA\) este o combinație liniară a rândurilor lui \(A\), coeficienții fiind dați de rândurile matricei \(E\).

\subsection{Înmulțirea la dreapta cu o matrice elementară}

Dacă \(F \in M_n(\mathbb{C})\) este o matrice elementară, atunci
\[
AF \in M_{m,n}(\mathbb{C})
\]
corespunde aplicării unei transformări elementare asupra coloanelor matricei \(A\):
\begin{itemize}
\item \(AP_{ij}\) schimbă coloanele \(i\) și \(j\) ale matricei \(A\);
\item \(AD_i(\alpha)\) înmulțește coloana \(i\) a lui \(A\) cu scalarul \(\alpha\);
\item \(AE_{ij}(\alpha)\) realizează operația \(C_j \leftarrow C_j + \alpha C_i\) (la dreapta rolurile indicilor se inversează: coloana $j$ a lui $AE_{ij}(\alpha)$ este $C_j + \alpha C_i$, celelalte coloane rămân neschimbate).
\end{itemize}

\section{Matrici echivalente}

\begin{definitie}
Fie \(A,B \in M_{m,n}(K)\). Spunem că matricile \(A\) și \(B\) sunt \emph{echivalente} și notăm
\[
A \sim B,
\]
dacă există matrici pătratice inversabile
\[
P \in M_m(K), \qquad Q \in M_n(K),
\]
astfel încât
\[
B = PAQ.
\]
\end{definitie}

\medskip

\textbf{Proprietati.}
\begin{enumerate}
\item Echivalența păstrează rangul:
\[
A \sim B \;\Longrightarrow\; \rang(A) = \rang(B).
\]

\item (Teorema fundamentală pentru matrici dreptunghiulare)
Dacă
\[
\rang(A) = \rang(B),
\]
atunci
\[
A \sim B.
\]

\item (Forma cea mai des folosita)
Fie \(A \in M_{m,n}(K)\) cu \(\rang(A) = r\). Atunci \(A\) este echivalentă cu matricea
\[
\begin{pmatrix}
I_r & 0 \\
0   & 0
\end{pmatrix}
\in M_{m,n}(K),
\]
unde \(I_r\) este matricea identitate de ordin \(r\). Adica:

\[
\begin{aligned}
\begin{pmatrix}
I_r & 0 \\
0   & 0
\end{pmatrix}
&=
\begin{pmatrix}
1 & 0 & \cdots & 0 & 0 & \cdots & 0 \\
0 & 1 & \cdots & 0 & 0 & \cdots & 0 \\
\vdots & \vdots & \ddots & \vdots & \vdots &  & \vdots \\
0 & 0 & \cdots & 1 & 0 & \cdots & 0 \\
0 & 0 & \cdots & 0 & 0 & \cdots & 0 \\
\vdots & \vdots &  & \vdots & \vdots & \ddots & \vdots \\
0 & 0 & \cdots & 0 & 0 & \cdots & 0
\end{pmatrix}
\end{aligned}
\]
\end{enumerate}


\textbf{Lema 1.} Fie $A\in M_n(\mathbb{C})$ cu $\rang A=m \ge 1$. Atunci există $X\in M_{n,m}(\mathbb{C})$ și $Y\in M_{m,n}(\mathbb{C})$ astfel încât $A=XY$. \\
 \textbf{Demonstrație.}  
Din forma canonică de mai sus (proprietatea 3 a matricelor echivalente) rezultă că există
matrice inversabile $P,Q \in M_n(\mathbb{C})$ astfel încât
\[
A = P B Q,
\]
unde matricea $B$ este de forma
\[
B=
\begin{bmatrix}
I_m & 0 \\
0   & 0
\end{bmatrix},
\]
cu exact $m$ elemente egale cu $1$ pe diagonala principală.

Definim acum matricele
\[
X_0 =
\begin{bmatrix}
I_m \\
0
\end{bmatrix}
\in M_{n,m}(\mathbb{C}),
\qquad
Y_0 =
\begin{bmatrix}
I_m & 0
\end{bmatrix}
\in M_{m,n}(\mathbb{C}),
\]
unde $X_0$ conține primele $m$ coloane ale matricei identitate din
$M_n(\mathbb{C})$, iar $Y_0$ conține primele $m$ linii ale aceleiași
matrici identitate.

Se observă imediat că
\[
B = X_0 Y_0.
\](din inmultirea matricelor pe blocuri)

Într-adevar, produsul $X_0Y_0$ are $1$ pe primele $m$ pozitii ale diagonalei
principale și zerouri in rest, exact ca matricea $B$.

Definim acum
\[
X := P X_0 \in M_{n,m}(\mathbb{C}), \qquad
Y := Y_0 Q \in M_{m,n}(\mathbb{C}).
\]
Atunci
\[
A = P B Q = P X_0 Y_0 Q = (P X_0)(Y_0 Q) = X Y.
\]

\begin{lema}\label{lema:rang1}
Fie $A\in M_n(\mathbb{C})$ cu $\rang A=1$. Atunci $A^2=\operatorname{tr}(A)\,A$.
\end{lema}

\begin{proof}
Presupunem $\operatorname{rang}(A)=1$. Atunci toate coloanele lui $A$ sunt proporționale. Există un vector nenul
$C\in\mathbb{C}^n$ și o linie $L\in M_{1,n}(\mathbb{C})$ astfel încât
\[
A = C\,L.
\]
Atunci
\[
A^2 = (CL)(CL)=C(LC)L.
\]
Deoarece $LC\in M_{1,1}(\mathbb{C})$ este un scalar, notat $\lambda$, avem
\[
A^2=\lambda\,CL.
\]
Pe de altă parte,
\[
\operatorname{tr}(A)=\operatorname{tr}(CL)=\operatorname{tr}(LC)=\lambda.
\]
Prin urmare,
\[
A^2=\operatorname{tr}(A)\,A,
\]
ceea ce trebuia demonstrat.
\end{proof}



















