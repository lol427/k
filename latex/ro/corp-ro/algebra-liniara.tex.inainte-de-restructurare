\chapter{Rangul matricelor}
\textbf{Definitie.}
Fie $A = (a_{ij}) \in M_{m,n}(\mathbb{C})$. Coloanele lui $A$ sunt
\[
\begin{aligned}
C_1 &=
\begin{pmatrix}
 a_{11}\\ a_{21}\\ \vdots\\ a_{m1}
\end{pmatrix}, \qquad
C_2 =
\begin{pmatrix}
 a_{12}\\ a_{22}\\ \vdots\\ a_{m2}
\end{pmatrix}, \qquad \dots, \qquad
C_n =
\begin{pmatrix}
 a_{1n}\\ a_{2n}\\ \vdots\\ a_{mn}
\end{pmatrix}
\end{aligned}
\]

\medskip

\[
\begin{aligned}
\rang(A)
&= \max \Big\{
k \;\Big|\;
\exists\, C_{i_1},\dots,C_{i_k}
\text{ coloane liniar independente}
\Big\}.
\end{aligned}
\]

\medskip

Coloanele $C_{i_1},\dots,C_{i_k}$ sunt liniar independente dacă
\[
\alpha_1 C_{i_1} + \cdots + \alpha_k C_{i_k} = 0
\;\Longrightarrow\;
\alpha_1 = \cdots = \alpha_k = 0,
\qquad
\alpha_i \in \mathbb{K}.
\]

\begin{definitie}
Un minor de ordin $k$ al matricii $A$ este determinantul unei submatrici pătrate
de ordin $k$, obținută din $A$ prin alegerea a $k$ linii și $k$ coloane.
\end{definitie}

\bigskip

\textbf{Definiția rangului prin minori.}
Rangul lui $A$ este cel mai mare $r$ pentru care există un minor de ordin $r$ nenul:
\[
\begin{aligned}
\rang(A) = r
\quad \Longleftrightarrow \quad
\begin{cases}
\exists \text{ minor de ordin } r \neq 0,\\
\text{toți minorii de ordin } r+1 \text{ sunt } 0.
\end{cases}
\end{aligned}
\]

\bigskip

\begin{teorema}
Rangul definit prin coloane liniar independente coincide cu rangul definit prin
minori nenuli.
\end{teorema}

\subsection{Proprietati}

\begin{enumerate}
\item
Fie $A = (a_{ij}) \in M_{m,n}(\mathbb{C})$.
\[
\rang(A) \le \min(m,n).
\]



\item
Dacă $A \in M_n(\mathbb{K})$ este pătrată, atunci
\[
\det(A) \neq 0
\quad \Longleftrightarrow \quad
\rang(A) = n.
\]

\item
\textbf{Matricea extinsă (alăturarea coloanelor).}
\[
\rang(A \pm B)
\le \rang(A\,|\,B)
\le \rang(A) + \rang(B),
\]
unde $(A\,|\,B)$ este matricea obținută prin alăturarea coloanelor lui $B$
la cele ale lui $A$.

\item
\textbf{Produs de matrici.}
Pentru $A \in M_{m,n}(\mathbb{K})$ și $B \in M_{n,p}(\mathbb{K})$:
\[
\rang(AB) \le \min\{\rang(A),\rang(B)\}.
\]

\item
\textbf{Inegalitatea lui Sylvester.}
\[
\rang(AB) \ge \rang(A) + \rang(B) - n.
\]

\item
\textbf{Inegalitatea lui Ferdinand Georg Frobenius.}
Pentru orice matrici
\[
A \in M_{m,n}(K), \quad
B \in M_{n,p}(K), \quad
C \in M_{p,q}(K),
\]
are loc inegalitatea
\[
\rang(AB) + \rang(BC) \le \rang(B) + \rang(ABC).
\]
\end{enumerate}







\begin{lema}\label{lema:rangadj}
Rangul adjunctei este determinat de rangul matricei inițiale. Mai precis, fie $A \in M_n(\mathbb{K})$, cu $n \ge 2$. Atunci sunt valabile următoarele afirmații:
\begin{enumerate}
    \item Dacă $\rang(A) = n$, atunci $\det(A) \neq 0$, $\adj(A) = \det(A) A^{-1}$ și $\rang(\adj(A))=n$. Dacă valorile proprii ale lui \(A\) sunt
\[
\lambda_1, \lambda_2, \dots, \lambda_n
\quad (\text{cu multiplicități}),
\]
atunci valorile proprii ale lui \(\operatorname{adj}(A)\) sunt
\[
\mu_i
=
\prod_{\substack{j=1 \\ j \neq i}}^{n} \lambda_j
=
\frac{\det A}{\lambda_i},
\quad \text{deoarece știm că } \lambda_i \neq 0.
\]
    \item Dacă $\rang(A) = n-1$, atunci $\rang(\adj(A)) = 1$.
    \item Dacă $\rang(A) \le n-2$, atunci $\adj(A) = O_n$, deci $\rang(\adj(A)) = 0$.
\end{enumerate}
\end{lema}

\begin{proof}
1. Din $A \adj(A) = \det(A) I_n$ și $\det(A) \neq 0$ rezultă $\adj(A) = \det(A) A^{-1}$, care este inversabilă. Valorile proprii ale lui $A^{-1}$ sunt $\frac{1}{\lambda_i}$ (cu aceleași multiplicități, deoarece $f_{A^{-1}}(X) = \frac{(-X)^n}{\det A} f_A\!\left(\frac{1}{X}\right)$), deci valorile proprii ale lui $\adj(A) = \det(A)A^{-1}$ sunt $\frac{\det A}{\lambda_i} = \prod_{j \neq i} \lambda_j$.

2. Cum $\rang(A) = n-1 < n$, avem $\det(A) = 0$, deci $A\adj(A) = \det(A) I_n = O_n$. Aplicând inegalitatea lui Sylvester matricelor $A, \adj(A) \in M_n(\mathbb{K})$:
\[
0=\rang(O_n)=\rang(A\adj(A))\geq \rang(A)+\rang(\adj(A)) - n = \rang(\adj(A)) - 1,
\]
deci $\rang(\adj(A)) \le 1$. Pe de altă parte, $\rang(A) = n-1$ înseamnă că $A$ are un minor nenul de ordin $n-1$, deci un complement algebric nenul, adică $\adj(A) \neq O_n$. Prin urmare $\rang(\adj(A)) = 1$.

3. Dacă $\rang(A) \le n-2$, toți minorii de ordin $n-1$ ai lui $A$ sunt nuli, deci toți complemenții algebrici sunt nuli și $\adj(A) = O_n$ (definiția adjunctei).
\end{proof}

